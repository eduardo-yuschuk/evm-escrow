# Overrides for docker compose: copy this file to .env and uncomment what you need.
# Every variable has a default, so the stack also runs without a .env file.

# Host ports. They are published on 127.0.0.1 only. Postgres is not published:
# docker compose exec postgres psql -U escrow escrow
# API_PORT=3000
# ANVIL_PORT=8545

# Indexer and API. The details are in docs/ai/DESIGN.md, "Proceso y configuración".
# Blocks on top of a block before it is indexed. Anvil only mines a block per transaction, so
# with N > 0 the last N blocks wait until N more transactions arrive. The demo mines them itself.
# CONFIRMATIONS=0
# BATCH_SIZE=1000
# POLL_INTERVAL_MS=1000
# Blocks of lag tolerated on top of CONFIRMATIONS before /health reports degraded.
# HEALTH_MAX_LAG=10
# LOG_LEVEL=info
# Anvil starts a new chain on every start while Postgres keeps its data: true wipes the database
# and reindexes the new chain, false makes the API abort instead.
# RESET_ON_CHAIN_MISMATCH=true

# Sepolia (docker-compose.sepolia.yml). Its keys go in .env.sepolia, not here: see .env.sepolia.example.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# SEPOLIA_API_PORT=3001
# SEPOLIA_CONFIRMATIONS=12
# SEPOLIA_BATCH_SIZE=10000
# Windows of a new deployment, in seconds.
# SEPOLIA_CANCEL_WINDOW=300
# SEPOLIA_TTL=600

# Monad testnet (docker-compose.monad.yml). Its keys go in .env.monad, not here: see .env.monad.example.
# MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# MONAD_API_PORT=3002
# MONAD_CONFIRMATIONS=10
# MONAD_BATCH_SIZE=100
# MONAD_HEALTH_MAX_LAG=50
# Windows of a new deployment, in seconds.
# MONAD_CANCEL_WINDOW=60
# MONAD_TTL=120
