# Keys for the Monad testnet deployment and demo (docker-compose.monad.yml). Copy this file to
# .env.monad, which git ignores, and fill it in. Never commit the keys. The keys go in hex, with or
# without 0x. The Sepolia keys work too: an account has the same address on every EVM chain.
#
# Only the deploy and demo services read this file: indexing the deployed contract needs none of it.
# Testnet MON for gas: https://faucet.monad.xyz

# Deploys the contracts and sends the demo's escrows. Needs about 0.4 MON: 0.2 for the deployment
# and less than that for the demo.
SENDER_PRIVATE_KEY=
# Confirms and rejects the demo's escrows. Needs about 0.05 MON.
BENEFICIARY_PRIVATE_KEY=
