# Keys for the Sepolia deployment and demo (docker-compose.sepolia.yml). Copy this file to
# .env.sepolia, which git ignores, and fill it in. Never commit the keys. The keys go in hex, with
# or without 0x.
#
# Only the deploy and demo services read this file: indexing the deployed contract needs none of it.

# Deploys the contracts and sends the demo's escrows. Needs Sepolia ETH for gas.
SENDER_PRIVATE_KEY=
# Confirms and rejects the demo's escrows. Needs Sepolia ETH for gas.
BENEFICIARY_PRIVATE_KEY=
# Optional: when set, the deployment is verified on Etherscan (https://etherscan.io/apidashboard).
ETHERSCAN_API_KEY=
