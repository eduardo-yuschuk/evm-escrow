{
  "name": "evm-escrow-api",
  "version": "0.1.0",
  "private": true,
  "description": "API and event indexer for the Escrow contract",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "abi": "tsx scripts/generate-abi.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
